{
 "mailer_subjects_recovery": "Elegí tu nueva contraseña · Trabajo Más Fácil",
 "mailer_templates_recovery_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Elegí tu nueva contraseña</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Pediste cambiar la contraseña de tu cuenta ({{ .Email }}). Tocá el botón y elegí una nueva. La podés usar después en la app del celular y en la web.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">\n            <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2C6566;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;padding:14px 28px;border-radius:12px;\">Elegir contraseña nueva</a>\n          </td></tr></table>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">El link sirve una sola vez y vence en una hora. Si no fuiste vos, ignorá este mail. Tu contraseña no cambia.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_confirmation": "Confirmá tu cuenta · Trabajo Más Fácil",
 "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Confirmá tu cuenta</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Te registraste en Trabajo Más Fácil con {{ .Email }}. Confirmá que este mail es tuyo para empezar a usar la app.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">\n            <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2C6566;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;padding:14px 28px;border-radius:12px;\">Confirmar mi cuenta</a>\n          </td></tr></table>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">El link sirve una sola vez y vence en una hora. Si no fuiste vos, ignorá este mail.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_invite": "Te invitaron a Trabajo Más Fácil",
 "mailer_templates_invite_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Te invitaron a Trabajo Más Fácil</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Te sumaron a Trabajo Más Fácil, la app que conecta estudios e instructores dentro de tu red. Tocá el botón para crear tu cuenta con {{ .Email }}.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">\n            <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2C6566;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;padding:14px 28px;border-radius:12px;\">Crear mi cuenta</a>\n          </td></tr></table>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">Si no esperabas esta invitación, ignorá este mail.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_magic_link": "Tu link para entrar · Trabajo Más Fácil",
 "mailer_templates_magic_link_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Entrá a Trabajo Más Fácil</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Tocá el botón para entrar a tu cuenta ({{ .Email }}) sin contraseña.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">\n            <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2C6566;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;padding:14px 28px;border-radius:12px;\">Entrar</a>\n          </td></tr></table>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">El link sirve una sola vez y vence en una hora. Si no fuiste vos, ignorá este mail.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_email_change": "Confirmá tu nuevo email · Trabajo Más Fácil",
 "mailer_templates_email_change_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Confirmá tu nuevo email</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Pediste cambiar el email de tu cuenta de {{ .Email }} a {{ .NewEmail }}. Confirmalo para que el cambio quede hecho.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">\n            <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2C6566;color:#FFFFFF;text-decoration:none;font-weight:bold;font-size:16px;padding:14px 28px;border-radius:12px;\">Confirmar el cambio</a>\n          </td></tr></table>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">El link sirve una sola vez y vence en una hora. Si no lo pediste vos, ignorá este mail: tu email no cambia.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_reauthentication": "Tu código: {{ .Token }} · Trabajo Más Fácil",
 "mailer_templates_reauthentication_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Tu código de verificación</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">Usá este código para confirmar que sos vos:</p>\n          <p style=\"margin:0;text-align:center;font-size:32px;letter-spacing:8px;font-weight:bold;color:#172322;font-family:'Courier New',monospace;\">{{ .Token }}</p>\n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">El código vence en una hora. Si no fuiste vos, ignorá este mail.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_password_changed_notification": "Cambiaste tu contraseña · Trabajo Más Fácil",
 "mailer_templates_password_changed_notification_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Cambiaste tu contraseña</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">La contraseña de tu cuenta ({{ .Email }}) se cambió recién. Desde ahora usá la nueva, en el celular y en la web.</p>\n          \n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">Si no fuiste vos, pedí una contraseña nueva desde \"¿Olvidaste tu contraseña?\" y escribinos a info@masfacil.com.ar.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
 "mailer_subjects_email_changed_notification": "Cambió el email de tu cuenta · Trabajo Más Fácil",
 "mailer_templates_email_changed_notification_content": "<!DOCTYPE html>\n<html lang=\"es\">\n<body style=\"margin:0;padding:0;background:#F4F7F7;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F4F7F7;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border-radius:20px;overflow:hidden;\">\n        <tr><td style=\"background:#163235;padding:28px;text-align:center;\">\n          <img src=\"https://masfacil.com.ar/logo-trabajo.png\" alt=\"Trabajo Más Fácil\" width=\"140\" style=\"display:inline-block;max-width:140px;height:auto;\">\n        </td></tr>\n        <tr><td style=\"padding:32px 28px 8px;\">\n          <h1 style=\"margin:0 0 12px;font-size:22px;line-height:28px;color:#172322;\">Cambió el email de tu cuenta</h1>\n          <p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#566362;\">El email de tu cuenta cambió de {{ .OldEmail }} a {{ .Email }}.</p>\n          \n          <p style=\"margin:24px 0 0;font-size:13px;line-height:19px;color:#93A09F;\">Si no fuiste vos, escribinos cuanto antes a info@masfacil.com.ar.</p>\n        </td></tr>\n        <tr><td style=\"padding:24px 28px 28px;\">\n          <hr style=\"border:none;border-top:1px solid #EBF1F0;margin:0 0 16px;\">\n          <p style=\"margin:0;font-size:12px;line-height:18px;color:#93A09F;text-align:center;\">\n            Trabajo Más Fácil · Estudios e instructores conectados<br>\n            <a href=\"https://masfacil.com.ar/trabajo\" style=\"color:#2C6566;\">masfacil.com.ar/trabajo</a>\n          </p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>\n"
